      "node_type": "agent",
      "agent_type": "novel-volume-outliner",
      "system_prompt_template": "",
      "first_message": "运行卷大纲规划。目标卷号：{{volume_number}}。\n读取已有卷大纲（如有），对比目标卷号与已有最大卷号判断行为：\n- 目标卷号 > 最大已有卷号 → 创建新卷\n- 目标卷号 ≤ 最大已有卷号 → 重写该卷，以已有卷纲为参考，输出覆盖旧内容\n直接输出纯 JSON，引擎自动保存。\n\n==== 世界观基础 ====\n{{world_foundation_file}}\n\n==== 故事引擎 ====\n{{story_plan_file}}\n\n==== 角色档案 ====\n{{character_profiles_file}}\\n\\n==== 本书规模 ====\\n预计篇幅：{{estimated_length}}\\n每章字数：{{words_per_chapter}}\n\n==== 已有卷大纲 ====\n{{volume_outline_file}}",
      "position": {
        "x": 450,
        "y": 140
      },
      "var_bindings": {},
      "node_params": {},
      "auto_flow": true,
      "enable_complete_node_task": false,
      "output_variable": "",
      "enable_reject_upstream": false,
      "max_reject_count": 3,
      "save_output_to_file": true,
      "output_file_path": "cache/vo/vo_output.json",
      "sub_workflow_params": {},
      "fail_auto_skip": false
    },
