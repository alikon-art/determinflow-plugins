        "timeout": 30,
        "script_group": "nvl"
      },
      "auto_flow": false,
      "enable_complete_node_task": true,
      "output_variable": "",
      "enable_reject_upstream": false,
      "max_reject_count": 3,
      "save_output_to_file": false,
      "output_file_path": "",
      "sub_workflow_params": {}
    }
