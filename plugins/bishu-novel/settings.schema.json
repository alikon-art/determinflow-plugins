{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bishu Novel Engine Settings",
  "description": "笔枢小说引擎的 PostgreSQL、外部服务与 Engine HMAC 配置。",
  "type": "object",
  "properties": {
    "DB_HOST": {
      "type": "string",
      "default": "127.0.0.1",
      "description": "novel_platform PostgreSQL 主机。"
    },
    "DB_PORT": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "default": 5432,
      "description": "novel_platform PostgreSQL 端口。"
    },
    "DB_NAME": {
      "type": "string",
      "default": "novel_platform",
      "description": "Novel API 独占的数据库名。"
    },
    "DB_USER": {
      "type": "string",
      "default": "postgres",
      "description": "PostgreSQL 用户。"
    },
    "DB_PASSWORD": {
      "type": "string",
      "format": "password",
      "description": "PostgreSQL 密码；不得写入插件源码或版本控制。"
    },
    "AI_DETECT_GATEWAY_URL": {
      "type": "string",
      "format": "uri",
      "default": "http://127.0.0.1:8002/detect",
      "description": "polish Workflow 使用的 AI Detect Gateway 地址。"
    },
    "ENGINE_SIGN_ENABLED": {
      "type": "boolean",
      "default": false,
      "description": "是否启用 Engine HMAC 验证。"
    },
    "ENGINE_SIGN_MODE": {
      "type": "string",
      "enum": [
        "observe",
        "enforce"
      ],
      "default": "observe",
      "description": "observe 只记录，enforce 拒绝无效签名。"
    },
    "ENGINE_SIGN_KEYS": {
      "type": "string",
      "format": "password",
      "description": "逗号分隔的 key-id:secret；enforce 模式每个 secret 至少 32 bytes。"
    },
    "ENGINE_SIGN_CLOCK_SKEW_SECONDS": {
      "type": "integer",
      "minimum": 1,
      "default": 300,
      "description": "签名时间戳允许偏差。"
    },
    "ENGINE_SIGN_NONCE_TTL_SECONDS": {
      "type": "integer",
      "minimum": 1,
      "default": 360,
      "description": "写请求 nonce 的进程内去重时间。"
    }
  }
}
